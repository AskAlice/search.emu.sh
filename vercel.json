{
  "version": 2,
  "builds": [
    {
      "src": "src/vercel.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/GeoLite2-City.mmdb",
          "src/suggestions/icons/**",
          "src/chromium/icons/**"
        ],
        "maxDuration": 60
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/web"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/suggest$",
      "has": [{ "type": "cookie", "key": "emu_bangs" }],
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-emu-bangs" },
          "args": "1"
        }
      ],
      "continue": true
    },
    {
      "src": "/(bangs|search|suggest|osd.xml|opensearch.xml|color/.*|icon/.*)",
      "dest": "/src/vercel.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
