{
  "version": 2,
  "builds": [
    {
      "src": "src/vercel.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/GeoLite2-City.mmdb",
          "src/suggestions/icons/**",
          "src/chromium/icons/**"
        ],
        "maxDuration": 60
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/web"
      }
    }
  ],
  "routes": [
    {
      "src": "/(bangs|search|suggest|osd.xml|opensearch.xml|color/.*|icon/.*)",
      "dest": "/src/vercel.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
