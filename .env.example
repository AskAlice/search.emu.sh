#CryptoCompare API
# https://min-api.cryptocompare.com/
CRYPTOCOMPARE_KEY="<your key here>"

# OpenRouter (OpenAI-compatible) — used for LLM inference
# See https://openrouter.ai/keys to sign up and get your key
OPENROUTER_API_KEY="<your key here>"

# OpenAI-compatible client config pointed at OpenRouter.
# The openai SDK reads OPENAI_API_KEY / OPENAI_BASE_URL, so we map them to OpenRouter.
OPENAI_API_KEY="${OPENROUTER_API_KEY}"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# Inference model: https://openrouter.ai/moonshotai/kimi-k2.7-code
OPENROUTER_MODEL="moonshotai/kimi-k2.7-code"
