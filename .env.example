#CryptoCompare API
# https://min-api.cryptocompare.com/
CRYPTOCOMPARE_KEY="<your key here>"

# OpenRouter (OpenAI-compatible) — used for LLM inference
# See https://openrouter.ai/keys to sign up and get your key
OPENROUTER_API_KEY="<your key here>"

# OpenAI-compatible client config pointed at OpenRouter.
# The openai SDK reads OPENAI_API_KEY / OPENAI_BASE_URL, so we map them to OpenRouter.
OPENAI_API_KEY="${OPENROUTER_API_KEY}"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# Inference model: https://openrouter.ai/moonshotai/kimi-k2.7-code
OPENROUTER_MODEL="moonshotai/kimi-k2.7-code"

# Movie/TV suggestions: set either the TMDB v3 API key or the read-access token.
TMDB_API_KEY=""
TMDB_ACCESS_TOKEN=""
# Optional result destinations; defaults are the individual TMDB detail pages.
# Supports {id} (TMDB ID), {query} (title + year), {title}, and {year}.
# Supply a complete Radarr/Sonarr URL template for your installation if desired.
MOVIE_URL_TEMPLATE=""
TV_URL_TEMPLATE=""

# Brave Suggest API (rich=true requires an autosuggest subscription with rich access).
BRAVE_SEARCH_API_KEY=""
