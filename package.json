    "protobufjs-cli": "^1.1.1",
    "tap": "^15.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "unocss": "66.12.0",
